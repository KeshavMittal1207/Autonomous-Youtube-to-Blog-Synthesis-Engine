# Groq API Key (Required for LLM generation, evaluation, and revision)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Dev.to API Key (Required only if publishing to Dev.to)
DEV_API_KEY=your_dev_to_api_key_here

# Model Configuration
MODEL=llama-3.1-8b-instant
FAST_MODEL=llama-3.1-8b-instant
MAX_ITERATIONS=3
TEMPERATURE=0.3
